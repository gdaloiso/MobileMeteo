{
  "expo": {
    "name": "Meteo",
    "slug": "meteo",
    "scheme": "meteo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Meteo usa la tua posizione solo per mostrarti le previsioni del luogo in cui ti trovi."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.gdalo.meteo"
    },
    "android": {
      "package": "it.gdalo.meteo",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "600f2caf-7fce-4f66-a022-6f4ece3f4bc7"
      }
    },
    "owner": "gdaloiso"
  }
}
